@article{anand2026insula,
  author       = {Anand, Vivek and May, Camilla and Laxpati, Neal and Gleichgerrcht, Zeke and Treadway, Michael and Rozell, Christopher and Alagapan, Sankaraleengam},
  title        = {Electrophysiological Dynamics of Insula in Effort Based Decision Making},
  journal = {Poster presented at the Society of Biological Psychiatry (SOBP) Annual Meeting},
  tags = {neuroscience, motivation, seeg, effort-based-decision-making, naturalistic},
  poster_url = {files/Alagapan_SOBP2026_Poster.pdf},
  abstract = {Motivational deficits—reduced engagement in daily activities—are key symptoms in various psychiatric disorders. Research using Effort-Based Decision-Making (EBDM) paradigms suggests these deficits stem from impaired evaluation of the effort-reward tradeoff. Understanding the neural circuit mechanisms of EBDM is vital for developing targeted therapies like brain stimulation. However, current EBDM studies often neglect metabolic constraints and rely on indirect measures (e.g., fMRI). To address this, we use stereoEEG and a novel, physiologically-demanding effort decision and learning task, PEDaL, which requires subjects to pedal a bike for physical exertion.},
  year         = {2026},
  month        = {April--May},
  address      = {New York, NY},
  note         = {Poster presentation}
}
